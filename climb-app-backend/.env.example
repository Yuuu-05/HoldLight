# MongoDB
MONGO_URI=mongodb://username:password@host:27017/database

# Auth
JWT_SECRET=replace_with_a_real_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
BODY_LIMIT=12mb
TRUST_PROXY=1
CORS_ORIGINS=https://app.example.com

# Vision
# The project now uses the xiaoxiae pipeline only.
VISION_PROVIDER=xiaoxiae
VISION_PYTHON_COMMAND=.venv/bin/python
VISION_REQUEST_TIMEOUT_MS=120000
VISION_WARM_ON_START=true
VISION_ALLOW_PUBLIC_WARM_HEALTH=false
VISION_INFER_WORKERS=1
VISION_CALIBRATION_WORKERS=2
VISION_WARM_INFER_WORKERS=1
VISION_BOOT_CALIBRATION_WORKERS=1
VISION_RATE_LIMIT_WINDOW_MS=60000
VISION_RATE_LIMIT_MAX=10
CALIBRATION_RATE_LIMIT_WINDOW_MS=60000
CALIBRATION_RATE_LIMIT_MAX=45

# Large runtime-downloaded model assets
# Mount the files directly at the existing paths, or provide URLs for the container to fetch on boot.
VISION_XIAOXIAE_HOLD_WEIGHTS_URL=
VISION_XIAOXIAE_ROUTE_WEIGHTS_URL=
# Optional auth for private downloads:
# VISION_MODEL_DOWNLOAD_AUTH_HEADER=Authorization: Bearer your_token
# VISION_MODEL_DOWNLOAD_BEARER_TOKEN=your_token
# VISION_MODEL_DOWNLOAD_RETRIES=3
# VISION_MODEL_DOWNLOAD_TIMEOUT_SECONDS=600

# MongoDB
MONGO_URI=mongodb://username:password@host:27017/database

# Auth
JWT_SECRET=replace_with_a_real_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
BODY_LIMIT=12mb
TRUST_PROXY=1
CORS_ORIGINS=https://app.example.com

# Vision
# The project now uses the xiaoxiae pipeline only.
VISION_PROVIDER=xiaoxiae
VISION_PYTHON_COMMAND=python
VISION_REQUEST_TIMEOUT_MS=120000
VISION_WARM_ON_START=true
VISION_RATE_LIMIT_WINDOW_MS=60000
VISION_RATE_LIMIT_MAX=10
CALIBRATION_RATE_LIMIT_WINDOW_MS=60000
CALIBRATION_RATE_LIMIT_MAX=45

# Natural voice (MeloTTS)
TTS_ENABLED=true
TTS_PYTHON_COMMAND=python
TTS_WARM_ON_START=true
TTS_REQUEST_TIMEOUT_MS=90000
TTS_CACHE_SIZE=24
TTS_RATE_LIMIT_WINDOW_MS=60000
TTS_RATE_LIMIT_MAX=35
MELO_TTS_DEVICE=cpu
MELO_TTS_DEFAULT_LANGUAGE=ZH
MELO_TTS_ZH_SPEAKER=ZH
MELO_TTS_EN_SPEAKER=EN-Default

# Production HTTPS example:
# APP_DOMAIN=climb.example.com
# CORS_ORIGINS=https://climb.example.com
#
# Temporary public-IP smoke test example (HTTP only, camera capture on mobile will not work):
# APP_DOMAIN=http://114.55.92.201
# CORS_ORIGINS=http://114.55.92.201
APP_DOMAIN=climb.example.com
ACME_EMAIL=ops@example.com
CORS_ORIGINS=https://climb.example.com

FRONTEND_API_BASE_URL=/api
BODY_LIMIT=12mb

MONGO_ROOT_USERNAME=climbadmin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_DB_NAME=climbapp
# Optional: use an external MongoDB instead of the local container.
# MONGO_URI=mongodb://username:password@mongo.example.com:27017/climbapp?authSource=admin

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

VISION_PROVIDER=xiaoxiae
VISION_REQUEST_TIMEOUT_MS=120000
VISION_WARM_ON_START=true
VISION_INFER_WORKERS=1
VISION_CALIBRATION_WORKERS=2
VISION_WARM_INFER_WORKERS=1
VISION_BOOT_CALIBRATION_WORKERS=1
VISION_RATE_LIMIT_WINDOW_MS=60000
VISION_RATE_LIMIT_MAX=10
CALIBRATION_RATE_LIMIT_WINDOW_MS=60000
CALIBRATION_RATE_LIMIT_MAX=45
